+
+
+# Writes at or above this address are read back and compared. The stock
+# firmware's serial / USB-C write routine programs flash without erasing it
+# there (only addresses 0 and 0x5000 erase), so a write that needs a bit set
+# (0 -> 1) is ACKed but does not take. Bluetooth's write routine, and H9
+# Toolbox Firmware's serial one (build b0135e0c and later), erase as needed
+# and always take.
+VERIFY_FROM = 0x3000
+
+
+def _verify_block(radio, block_addr, size):
+    """Read a block back after writing it; retry a mismatch once, then fail."""
+    _channel_offset = 0x08
+    want = bytes(radio.get_mmap()[block_addr + _channel_offset:
+                                  block_addr + size + _channel_offset])
+    got = _read_block(radio, block_addr, size)
+    if bytes(got) == want:
+        return
+    _write_block(radio, block_addr, size)
+    got = _read_block(radio, block_addr, size)
+    if bytes(got) == want:
+        return
+    _diff = [i for i in range(min(len(got), len(want))) if got[i] != want[i]]
+    # a bit that has to go 0 -> 1
+    _need_set = any(want[i] & ~got[i] for i in _diff)
+    _first = block_addr + (_diff[0] if _diff else 0)
+    _msg = ('Block 0x%04x did not read back as written (%d byte(s) differ, '
+            'first at 0x%04x).' % (block_addr, len(_diff), _first))
+    if _need_set:
+        _msg += ('\nThe radio ACKed the write but kept the old bits: this '
+                 'connection cannot set bits above 0x3000 on this firmware.\n'
+                 'Upload over a BLE serial connection, or use a radio running '
+                 'H9 Toolbox Firmware (h9toolbox.com), whose serial and USB-C '
+                 'writes work there.')
+    LOG.error(_msg)
+    raise errors.RadioError(_msg)
 
 
