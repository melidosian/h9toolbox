--- /dev/null
+++ b/ax25/l2/h9_test.go
@@ -0,0 +1,35 @@
+package l2
+
+import (
+	"bytes"
+	"github.com/ben-kuhn/tncd/v2/ax25"
+	"testing"
+)
+
+func TestH9SmallFramesPreserveStream(t *testing.T) {
+	tbl, rec, _ := newHarness(1200)
+	tbl.params[0].MaxInfo = 64
+	tbl.params[0].MaxWindow = 1
+	c := connect(t, tbl, rec)
+	data := bytes.Repeat([]byte{0xC0, 0xDB, 0x00, 0xFF}, 150)
+	tbl.SendData(c, 0xF0, data[:127])
+	tbl.SendData(c, 0xF0, data[127:])
+	var got []byte
+	seen := 0
+	for tbl.Outstanding(c) > 0 {
+		frames := iframes(rec)
+		if len(frames) != seen+1 {
+			t.Fatalf("window should send one frame at a time: %d seen %d", len(frames), seen)
+		}
+		f := frames[seen]
+		if len(f.Info) > 64 {
+			t.Fatalf("oversize info: %d", len(f.Info))
+		}
+		got = append(got, f.Info...)
+		seen++
+		tbl.OnFrame(0, mkFrame(ax25.RR, "N0CALL-2", "KU0HN-10", resp, nr((f.NS+1)%8)))
+	}
+	if !bytes.Equal(got, data) {
+		t.Fatal("fragmentation/coalescing changed stream bytes")
+	}
+}
