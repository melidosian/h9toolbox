diff --git a/ax25/l2/h9_retry_test.go b/ax25/l2/h9_retry_test.go
new file mode 100644
index 0000000..5bf7512
--- /dev/null
+++ b/ax25/l2/h9_retry_test.go
@@ -0,0 +1,203 @@
+package l2
+
+import (
+	"bytes"
+	"testing"
+	"time"
+
+	"github.com/ben-kuhn/tncd/v2/ax25"
+)
+
+func TestH9IdlePollDoesNotDelayDataRetry(t *testing.T) {
+	tbl, rec, clock := newHarness(1200)
+	tbl.params[0].T1 = 5 * time.Second
+	tbl.params[0].T3 = 8 * time.Second
+	c := connect(t, tbl, rec)
+	tbl.SendData(c, 0xf0, []byte("first"))
+	clock.advance(5 * time.Second)
+	if got := len(rec.sent); got != 2 {
+		t.Fatalf("frames after the first data timeout = %d, want 2", got)
+	}
+	clock.advance(3 * time.Second)
+	if got := len(rec.sent); got != 2 {
+		t.Fatalf("idle timer sent a poll while data was pending: %d frames, want 2", got)
+	}
+	clock.advance(7 * time.Second)
+	if got := len(iframes(rec)); got != 2 {
+		t.Fatalf("data frames after the second data timeout = %d, want 2", got)
+	}
+}
+
+func TestH9RRFinalAtSameSequenceRetriesOutstandingData(t *testing.T) {
+	tbl, rec, clock := newHarness(1200)
+	tbl.params[0].MaxWindow = 1
+	c := connect(t, tbl, rec)
+	first := []byte("first")
+	tbl.SendData(c, 0xf0, first)
+	tbl.SendData(c, 0xf0, []byte("second"))
+
+	poll := mkFrame(ax25.RR, "N0CALL-2", "KU0HN-10", pf, resp, nr(0))
+	tbl.OnFrame(0, poll)
+	if got := len(iframes(rec)); got != 1 {
+		t.Fatalf("unsolicited final retransmitted data: %d frames", got)
+	}
+	clock.advance(tbl.params[0].T1)
+	tbl.OnFrame(0, poll)
+	frames := iframes(rec)
+	if len(frames) != 2 || frames[1].NS != 0 || !bytes.Equal(frames[1].Info, first) {
+		t.Fatalf("unchanged final RR failed to retry frame zero: %+v", frames)
+	}
+	tbl.OnFrame(0, poll)
+	if got := len(iframes(rec)); got != 2 {
+		t.Fatalf("duplicate final retransmitted again: %d frames", got)
+	}
+	tbl.OnFrame(0, mkFrame(ax25.RR, "N0CALL-2", "KU0HN-10", pf, resp, nr(1)))
+	frames = iframes(rec)
+	if len(frames) != 3 || frames[2].NS != 1 || string(frames[2].Info) != "second" {
+		t.Fatalf("advancing ACK failed to release the queued frame: %+v", frames)
+	}
+}
+
+func TestH9DataRetriesAfterLostUA(t *testing.T) {
+	tbl, rec, clock := newHarness(1200)
+	tbl.params[0].T1 = 5 * time.Second
+	tbl.params[0].T3 = 0
+	tbl.params[0].N2Retry = 3
+
+	c, err := tbl.Connect(0, "KU0HN-10", "N0CALL-2", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	clock.advance(5 * time.Second)
+	clock.advance(5 * time.Second)
+	tbl.OnFrame(0, mkFrame(ax25.I, "N0CALL-2", "KU0HN-10", ns(1), info([]byte("greeting"))))
+	if c.State != Connected || c.t1 != nil || c.t1Polls != 0 {
+		t.Fatalf("greeting did not clear setup retries: connected=%t setup timer=%t retries=%d",
+			c.State == Connected, c.t1 != nil, c.t1Polls)
+	}
+
+	login := []byte("login data")
+	tbl.SendData(c, 0xf0, login)
+	clock.advance(5 * time.Second)
+	if last := rec.sent[len(rec.sent)-1]; last.Type != ax25.RR || !last.PF || len(iframes(rec)) != 1 {
+		t.Fatal("first data timeout did not poll before retrying the login frame")
+	}
+	clock.advance(10 * time.Second)
+	frames := iframes(rec)
+	if c.State != Connected || len(frames) != 2 || frames[1].NS != 0 || !bytes.Equal(frames[1].Info, login) {
+		t.Fatal("data timeout exhausted the connection setup's retries")
+	}
+}
+
+func TestH9StopAndWaitRetryPollsWithTheDataFrame(t *testing.T) {
+	tbl, rec, clock := newHarness(1200)
+	tbl.params[0].MaxWindow = 1
+	tbl.params[0].T1 = 5 * time.Second
+	c := connect(t, tbl, rec)
+	tbl.SendData(c, 0xf0, []byte("login"))
+	clock.advance(5 * time.Second)
+	if len(rec.sent) != 2 || rec.sent[1].Type != ax25.RR || !rec.sent[1].PF {
+		t.Fatal("first timeout must poll for the missing acknowledgement")
+	}
+	clock.advance(10 * time.Second)
+	if len(rec.sent) != 3 || rec.sent[2].Type != ax25.I || !rec.sent[2].PF ||
+		rec.sent[2].NS != 0 || string(rec.sent[2].Info) != "login" {
+		t.Fatal("second timeout must retry the data and request its acknowledgement in one frame")
+	}
+}
+
+func TestH9RejectDoesNotRepeatNewlyReleasedData(t *testing.T) {
+	tbl, rec, _ := newHarness(1200)
+	tbl.params[0].MaxWindow = 1
+	c := connect(t, tbl, rec)
+	tbl.SendData(c, 0xf0, []byte("first"))
+	tbl.SendData(c, 0xf0, []byte("second"))
+	rec.sent = nil
+
+	tbl.OnFrame(0, mkFrame(ax25.REJ, "N0CALL-2", "KU0HN-10", resp, nr(1)))
+	frames := iframes(rec)
+	if len(frames) != 1 || frames[0].NS != 1 || string(frames[0].Info) != "second" {
+		t.Fatalf("reject acknowledging frame zero sent %d data frames, want only new frame one", len(frames))
+	}
+}
+
+func TestH9TimedOutDataReleasesPeerLink(t *testing.T) {
+	tbl, rec, clock := newHarness(1200)
+	tbl.params[0].T1 = 5 * time.Second
+	tbl.params[0].N2Retry = 1
+	c := connect(t, tbl, rec)
+	tbl.SendData(c, 0xf0, []byte("login"))
+	clock.advance(5 * time.Second)
+	clock.advance(10 * time.Second)
+	if len(rec.sent) != 3 || rec.sent[2].Type != ax25.DISC || !rec.sent[2].PF || rec.disconnected != 1 {
+		t.Fatal("retry exhaustion must request release of the remote link")
+	}
+}
+
+func TestH9DisconnectRetriesLostUA(t *testing.T) {
+	tbl, rec, clock := newHarness(1200)
+	tbl.params[0].T1 = 5 * time.Second
+	tbl.params[0].N2Retry = 1
+	c := connect(t, tbl, rec)
+	tbl.Disconnect(c)
+	clock.advance(5 * time.Second)
+	if len(rec.sent) != 2 || rec.sent[1].Type != ax25.DISC || !rec.sent[1].PF {
+		t.Fatal("unanswered disconnect was not retried")
+	}
+	clock.advance(5 * time.Second)
+	if rec.disconnected != 1 || tbl.Get(0, c.Local, c.Remote) != nil {
+		t.Fatal("disconnect did not release the local session after its retries")
+	}
+}
+
+func TestH9BatchesBinaryTransferWrites(t *testing.T) {
+	tbl, rec, clock := newHarness(1200)
+	tbl.params[0].MaxWindow = 1
+	tbl.params[0].MaxInfo = 80
+	tbl.params[0].TxBatchDelay = 100 * time.Millisecond
+	c := connect(t, tbl, rec)
+
+	header := []byte("\x01\x11synthetic header\x000\x00")
+	blockHeader := []byte{2, 0}
+	body := make([]byte, 237)
+	for i := range body {
+		body[i] = byte(i)
+	}
+	trailer := []byte{4, 0x9f}
+
+	tbl.SendData(c, 0xf0, header)
+	clock.advance(40 * time.Millisecond)
+	tbl.SendData(c, 0xf0, blockHeader)
+	tbl.SendData(c, 0xf0, body)
+	tbl.SendData(c, 0xf0, trailer)
+	if len(iframes(rec)) != 0 || tbl.Outstanding(c) == 0 {
+		t.Fatal("buffered bytes must count as outstanding before transmission")
+	}
+	clock.advance(60 * time.Millisecond)
+	want := bytes.Join([][]byte{header, blockHeader, body, trailer}, nil)
+	var joined []byte
+	for n, remaining := 0, len(want); remaining > 0; n++ {
+		frames := iframes(rec)
+		if len(frames) != n+1 || len(frames[n].Info) != min(80, remaining) {
+			t.Fatalf("frame %d was missing, oversized, or left space unused", n)
+		}
+		joined = append(joined, frames[n].Info...)
+		remaining -= len(frames[n].Info)
+		tbl.OnFrame(0, mkFrame(ax25.RR, "N0CALL-2", "KU0HN-10", resp, nr(uint8(n+1))))
+	}
+	if !bytes.Equal(joined, want) || tbl.Outstanding(c) != 0 {
+		t.Fatal("transmit batching changed the byte stream or left data pending")
+	}
+}
+
+func TestH9DisconnectCancelsBatchedWrite(t *testing.T) {
+	tbl, rec, clock := newHarness(1200)
+	tbl.params[0].TxBatchDelay = 100 * time.Millisecond
+	c := connect(t, tbl, rec)
+	tbl.SendData(c, 0xf0, []byte("pending"))
+	tbl.Disconnect(c)
+	clock.advance(100 * time.Millisecond)
+	if len(rec.sent) != 1 || rec.sent[0].Type != ax25.DISC {
+		t.Fatal("data escaped the transmit batch after disconnect started")
+	}
+}
