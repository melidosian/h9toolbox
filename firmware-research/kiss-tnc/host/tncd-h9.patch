+++ b/internal/config/h9_test.go
@@ -0,0 +1,20 @@
+package config
+
+import "testing"
+
+func TestH9InfoLimit(t *testing.T) {
+	base := "[client.0]\ntype=tcp\nhost=127.0.0.1\nport=8100\n[ax25]\n"
+	c, err := Load(write(t, base+"max_info=64\n"))
+	if err != nil || c.AX25.MaxInfo != 64 {
+		t.Fatalf("64-byte setting: %+v %v", c, err)
+	}
+	c, err = Load(write(t, base))
+	if err != nil || c.AX25.MaxInfo != 256 {
+		t.Fatal("upstream default changed")
+	}
+	for _, n := range []string{"0", "257", "-1"} {
+		if _, err := Load(write(t, base+"max_info="+n+"\n")); err == nil {
+			t.Fatalf("accepted %s", n)
+		}
+	}
+}
